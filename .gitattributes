# Stowly wird unter Windows entwickelt und unter Linux ausgeführt.
# Alle Textdateien liegen deshalb auch im Arbeitsverzeichnis mit LF vor,
# unabhängig von core.autocrlf auf dem jeweiligen Rechner.
* text=auto eol=lf

# Ausdrücklich: Dateien, die unter Linux mit CRLF nicht funktionieren.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
docker-compose.yml text eol=lf
.env.example    text eol=lf
*.service       text eol=lf
*.rules         text eol=lf
*.conf          text eol=lf
*.py            text eol=lf
*.sql           text eol=lf

# Binärdateien nie umwandeln.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.wasm    binary
*.sqlite3 binary
*.db      binary
*.pdf     binary

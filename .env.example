# Stowly: Einstellungen des Servers. Nach .env kopieren und anpassen.
# Die Datei .env enthält Passwort und Tokens und gehört nicht ins Repository.
# Geänderte Werte gelten nach:  docker compose up -d
# Beim Start prüft der Server jeden Wert; ein Fehler beendet den Start mit einer Meldung, die die
# Variable nennt (docker compose logs stowly).

# Haushalts-Passwort, mit dem sich jedes Gerät einmal anmeldet. Pflicht: Ohne Passwort
# startet der Server, aber niemand kann sich anmelden. Ein geändertes Passwort lässt
# bereits angemeldete Geräte angemeldet; einzelne Geräte sperrt man in der App.
STOWLY_PASSWORD=

# Produktdaten und Vorschaubilder bei Open Food Facts nachschlagen (1/0).
# Dabei gehen die Barcodes unbekannter Produkte an world.openfoodfacts.org,
# höchstens 10 Abfragen je Minute. Mit 0 bleibt jedes Produkt, wie es eingetippt wurde.
STOWLY_OFF_ENABLED=1

# Freiwillig: Kontakt für den User-Agent gegenüber Open Food Facts, z. B. eine
# Adresse, unter der der Betreiber dieser Installation erreichbar ist. Leer = keiner.
STOWLY_OFF_CONTACT=

# Meldungen des Servers: critical, error, warning, info, debug, trace
STOWLY_LOG_LEVEL=info

# Zeitzone für „heute" und alle Uhrzeiten (Sicherung, Tagesnachricht), als IANA-Name.
STOWLY_TIMEZONE=Europe/Berlin

# Automatische, verschlüsselte Sicherung (docs/betrieb.md, Abschnitt 8.1). Der Ordner im Container;
# docker-compose.yml legt ./backups dorthin. Er muss dem Benutzer 10001 gehören:
#   mkdir -p backups && sudo chown 10001:10001 backups
STOWLY_BACKUP_DIR=/backups
# Öffentliche age-Schlüssel (age1…, erzeugt mit age-keygen), getrennt durch Komma oder Leerzeichen.
# Mehrere sind empfohlen. Nur öffentliche Schlüssel, nie den privaten. Leer = keine automatische
# Sicherung (die App nennt dann den Grund).
STOWLY_BACKUP_RECIPIENTS=
# Uhrzeit der täglichen Sicherung, HH:MM in STOWLY_TIMEZONE.
STOWLY_BACKUP_TIME=03:30

# Benachrichtigungen per Web-Push (docs/betrieb.md, Abschnitt 15): Absender, mailto:<Adresse> oder eine
# https-Adresse. Apple lehnt Nachrichten ohne gültigen Absender ab. Leer = kein Push, auch keine
# Tagesnachricht. Deren Uhrzeit stellt man in der App ein, in der Zeitzone STOWLY_TIMEZONE.
STOWLY_PUSH_CONTACT=

# Einkaufsliste nach Bring! über Home Assistant (docs/betrieb.md, Abschnitt 17). Alle drei setzen,
# sonst gibt es kein Bring! (die App nennt dann, was fehlt).
# Adresse von HA als IP oder Name aus dem eigenen DNS (.local löst im Container nicht auf), ohne Pfad,
# etwa http://192.168.1.20:8123 oder https://ha.example:8123.
STOWLY_HA_URL=
# Langlebiger Zugangs-Token aus HA, am besten von einem eigenen HA-Benutzer nur für Stowly.
# Er steht nur hier: nie in der Datenbank, einer Sicherung oder dem Log.
STOWLY_HA_TOKEN=
# Die To-do-Liste in HA, die mit Bring! verbunden ist, etwa todo.einkaufsliste.
STOWLY_HA_TODO_ENTITY=
# Freiwillig: PEM-Datei der eigenen Zertifizierungsstelle, wenn HA per https mit eigenem Zertifikat
# läuft. Pfad im Container, etwa /config/ha-ca.pem, eingebunden über docker-compose.override.yml
# (docs/betrieb.md, Abschnitt 17.4). Leer = die Zertifizierungsstellen des Systems.
STOWLY_HA_CA=
# Token des Sensors /api/ha/summary für HA (docs/betrieb.md, Abschnitt 18), mindestens 32 Zeichen,
# etwa: openssl rand -hex 32. Er gilt nur für den Sensor. Leer = kein Sensor.
STOWLY_HA_SUMMARY_TOKEN=

# Content-Security-Policy der Web-App. Leer = die vorsichtige Vorgabe des Servers
# (docs/betrieb.md, Abschnitt 13), off = keine. Ein eigener Wert ersetzt die Vorgabe ganz;
# dann in doppelte Anführungszeichen setzen, etwa:
# STOWLY_CSP="default-src 'self'; img-src 'self' blob: data:"
STOWLY_CSP=

# Nur mit docker-compose.usb.yml (Brother am USB des Servers): Gruppe, der die udev-Regel
# des Rechners den Drucker gibt. Vorgabe 46 = plugdev unter Debian.
# STOWLY_USB_GID=46

# Unter welcher Adresse des Rechners der Container erreichbar ist (nur Docker Compose).
# Vorgabe 127.0.0.1:8010: nur für einen Reverse Proxy auf demselben Rechner.
# 8010 allein = von jedem Rechner im Netz erreichbar (Proxy auf einem anderen Rechner).
# STOWLY_PUBLISH=127.0.0.1:8010

# Zeitzone des Containers (nur Docker). Stowly selbst richtet sich nach STOWLY_TIMEZONE;
# alle gespeicherten Zeitpunkte sind ohnehin UTC.
# TZ=Europe/Berlin

# Welchen Adressen der Server die Kopfzeilen X-Forwarded-For glaubt (nur für das Zugriffs-Log:
# Dann steht dort das Gerät statt des Proxys). Nur setzen, wenn ausschließlich der Proxy
# den Container erreicht.
# FORWARDED_ALLOW_IPS=*

# Im Container bereits gesetzt, nur beim Betrieb ohne Docker nötig:
# STOWLY_HOST=0.0.0.0
# STOWLY_PORT=8010
# STOWLY_DATA_DIR=/data
# STOWLY_WEB_DIR=/app/web
# STOWLY_OFF_URL=https://world.openfoodfacts.org

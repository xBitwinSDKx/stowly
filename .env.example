# Stowly: Einstellungen des Servers. Nach .env kopieren und anpassen.
# Die Datei .env enthält das Passwort und gehört nicht ins Repository.

# Haushalts-Passwort, mit dem sich jedes Gerät einmal anmeldet. Pflicht.
STOWLY_PASSWORD=

# Produktdaten und Vorschaubilder bei Open Food Facts nachschlagen (1/0).
# Dabei gehen die Barcodes unbekannter Produkte an world.openfoodfacts.org.
STOWLY_OFF_ENABLED=1

# Freiwillig: Kontakt für den User-Agent gegenüber Open Food Facts, z. B. eine
# Adresse, unter der der Betreiber dieser Installation erreichbar ist.
STOWLY_OFF_CONTACT=

# Meldungen des Servers: debug, info, warning, error
STOWLY_LOG_LEVEL=info

# Im Container bereits gesetzt, nur beim Betrieb ohne Docker nötig:
# STOWLY_HOST=0.0.0.0
# STOWLY_PORT=8010
# STOWLY_DATA_DIR=/data
# STOWLY_WEB_DIR=/app/web
